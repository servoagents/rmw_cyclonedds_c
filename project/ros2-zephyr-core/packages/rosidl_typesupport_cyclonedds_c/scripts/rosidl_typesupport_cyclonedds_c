#!/usr/bin/env python3

import argparse

from rosidl_typesupport_cyclonedds_c import generate_typesupport_cyclonedds_c


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--generator-arguments-file', required=True)
    args = parser.parse_args()
    generate_typesupport_cyclonedds_c(args.generator_arguments_file)


if __name__ == '__main__':
    main()
