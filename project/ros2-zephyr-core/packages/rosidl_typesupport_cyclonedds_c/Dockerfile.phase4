FROM ros2-zephyr-kilted-rmw-c:phase3

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ros-kilted-rosidl-generator-dds-idl=0.12.1-1noble.20260715.011628 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /phase4_ws
COPY rosidl_typesupport_cyclonedds_c /phase4_ws/src/rosidl_typesupport_cyclonedds_c
COPY phase4_test_msgs /phase4_ws/src/phase4_test_msgs
COPY rmw_cyclonedds_c /phase4_ws/src/rmw_cyclonedds_c

RUN . /opt/ros/kilted/setup.sh \
    && colcon --log-base /phase4_ws/log build \
      --build-base /phase4_ws/build \
      --install-base /phase4_ws/install \
      --packages-up-to rmw_cyclonedds_c \
      --cmake-args -DCMAKE_BUILD_TYPE=RelWithDebInfo

RUN . /opt/ros/kilted/setup.sh \
    && . /phase4_ws/install/setup.sh \
    && /phase4_ws/install/rosidl_typesupport_cyclonedds_c/lib/rosidl_typesupport_cyclonedds_c/check_fixed_profile.py \
    && /phase4_ws/install/phase4_test_msgs/lib/phase4_test_msgs/phase4_generated_conversion_test \
    && RMW_IMPLEMENTATION=rmw_cyclonedds_c \
      /phase4_ws/install/rmw_cyclonedds_c/lib/rmw_cyclonedds_c/phase4_generated_rmw \
    && RMW_IMPLEMENTATION=rmw_cyclonedds_c \
      /phase4_ws/install/rmw_cyclonedds_c/lib/rmw_cyclonedds_c/phase3_trace_minimal_rclc
